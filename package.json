{
  "name": "@mambalabsdev/mcp-substack-scraper",
  "version": "1.0.0",
  "description": "MCP server for Substack Scraper. Read Substack publications and posts, or search Substack by keyword: subscriber counts, paid plan prices, and every post with date, paid flag, likes, comments, and restacks. Runs on Apify. Clay-ready output.",
